---
interface Props {
  siteTitle: string;
}
const { siteTitle } = Astro.props;

const now = new Date();
const lastUpdated = now.toLocaleString("pt-BR", {
  timeZone: "America/Sao_Paulo",
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});

const menu = [
  { name: "Início", url: "/" },
  { name: "Jogos", url: "/jogos/" },
  { name: "Autores", url: "/autores/" },
  { name: "Círculos", url: "/circulos/" },
  { name: "Recursos", url: "/recursos/" },
  { name: "FAQ", url: "/recursos/faq/" },
];

const currentPath = Astro.url.pathname;
const normalize = (p: string) => (p.endsWith("/") ? p : `${p}/`);
---

<div class="flex flex-wrap justify-between align-center bg-frame border-bottom padding-rect-sm">
  <div class="flex align-center logotype">
    <a href="/">
      <img id="logotype" src="/logotypes/Patcheados.png" alt={siteTitle} />
    </a>
  </div>
  <div class="divider-v">
    <small>Última Atualização: {lastUpdated}</small>
    <a href="https://github.com/Heruzinyo/Patcheados" target="_blank" rel="noopener">GitHub</a>
    <a href="/rss.xml" target="_blank" rel="noopener">RSS</a>
  </div>
</div>

<input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
<label for="nav-toggle" class="nav-toggle-label pointer bg-body border-bottom padding-rect-sm">Menu</label>

<nav class="nav-menu flex flex-wrap bg-body border-bottom padding-rect-sm gap-md" aria-label="Navegação principal">
  {
    menu.map((item) => (
      <a href={item.url} aria-current={normalize(currentPath) === normalize(item.url) ? "page" : undefined}>
        {item.name}
      </a>
    ))
  }
</nav>

<script is:inline>
  (function () {
    function updateLogo(theme) {
      const logo = document.getElementById("logotype");
      if (logo && theme) logo.src = `/logotypes/${theme}.png`;
    }

    // This script lives in the swapped body, so it re-executes fresh on
    // every navigation (unlike head scripts, it isn't deduped by Astro).
    updateLogo(window.localStorage.getItem("theme"));

    document.addEventListener("themechange", (e) => updateLogo(e.detail.theme));
  })();
</script>
