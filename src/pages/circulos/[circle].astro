---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import EntryRow from "../../components/cards/EntryRow.astro";
import PatchRow from "../../components/cards/PatchRow.astro";
import { getDb } from "../../lib/db";
import { authorUrl } from "../../lib/url";
import { getCircleMembers, getCreditRolesLabel, getCreditedPatches } from "../../lib/credits";
import { formatDatePtBr, toLabel, displayTitle } from "../../lib/game";
import { getVocab } from "../../lib/search/vocab";
import { resolveAvatarSrc, resolveLogoSrc } from "../../lib/media";

export async function getStaticPaths() {
  const circles = await getCollection("circles");
  return circles.map((circle) => ({ params: { circle: circle.id }, props: { circle } }));
}

const { circle } = Astro.props;
const { Content } = await render(circle);

const db = await getDb();
const vocab = await getVocab();
const activitiesVocab = vocab.get("activities");

const members = await getCircleMembers(circle);

// "Patches Trabalhados" - ownership (circles[] flat array).
const ownedPatches = db.patchesByCircleId.get(circle.id) ?? [];
const ownedWithGames = ownedPatches
  .map((patch) => {
    const game = db.gameById.get(patch.id.split("/")[0]);
    return game ? { patch, game } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

ownedWithGames.sort((a, b) => displayTitle(a.game, a.patch).localeCompare(displayTitle(b.game, b.patch), "pt-BR"));

// "Patches Creditados" - detailed credits[] array, is_circle = true.
const creditedPatches = await getCreditedPatches(circle.id, true);
  const creditedWithRoles = await Promise.all(
    creditedPatches.map(async (patch) => {
      const game = db.gameById.get(patch.id.split("/")[0]);
      if (!game) return null;
      return { patch, game, roleLine: await getCreditRolesLabel(patch, circle.id, true) };
    })
  ).then((arr) => arr.filter((x): x is NonNullable<typeof x> => x !== null));

creditedWithRoles.sort((a, b) => displayTitle(a.game, a.patch).localeCompare(displayTitle(b.game, b.patch), "pt-BR"));

const logoSrc = resolveLogoSrc(circle);

// "Tags do Jogo" filter - reuses games already resolved above instead of re-fetching.
const gameTags = new Set<string>();
for (const { game } of ownedWithGames) {
  for (const tag of game.data.tags) gameTags.add(tag);
}
---

<Base
  title={circle.data.title}
  description={circle.body
    ? circle.body.replace(/\s+/g, " ").trim().slice(0, 155)
    : `Perfil do círculo ${circle.data.title} no Patcheados.`}
>
  <section class="flex flex-column gap-lg">
    <div class="bordered">
      <div class="bg-frame padding-sm">
        <h1>{circle.data.title}</h1>
      </div>
      {circle.body && (
      <div class="flex flex-column bg-body border-top padding-md gap-sm">
        <Content />
      </div>
      )}
    </div>

    {
      members.length > 0 && (
        <div class="bordered">
          <div class="bg-frame border-bottom padding-sm">
            <h2>Membros</h2>
          </div>
          <div class="bg-body padding-md grid grid-3col gap-md">
            {members.map((m) =>
              m.author ? (
                <EntryRow
                  href={authorUrl(m.author)}
                  mediaKind="icon"
                  mediaSrc={resolveAvatarSrc(m.author)}
                  mediaAlt={m.author.data.title}
                  title={m.author.data.title}
                  roleLine={m.roles.length > 0 ? m.roles.join(", ") : undefined}
                />
              ) : null
            )}
          </div>
        </div>
      )
    }

    {
      ownedWithGames.length > 0 && (
        <div class="bordered">
          <div class="bg-frame border-bottom padding-sm">
            <h2>Patches Trabalhados</h2>
          </div>
          <div class="bg-body padding-md flex flex-column gap-md">
            {ownedWithGames.map(({ patch, game }) => (
              <PatchRow
                game={game}
                patch={patch}
                showCreator={patch.data.authors.length + patch.data.circles.length > 1}
              />
            ))}
          </div>
        </div>
      )
    }

    {
      creditedWithRoles.length > 0 && (
        <div class="bordered">
          <div class="bg-frame border-bottom padding-sm">
            <h2>Patches Creditados</h2>
          </div>
          <div class="bg-body padding-md flex flex-column gap-md">
            {creditedWithRoles.map(({ patch, game, roleLine }) => (
              <PatchRow game={game} patch={patch} roleLine={roleLine} />
            ))}
          </div>
        </div>
      )
    }
  </section>

  <aside class="flex flex-column gap-lg">
    <div class="bordered">
      <div class="wrapper bg-frame"><img src={logoSrc} alt={`Logo de ${circle.data.title}`} loading="lazy" /></div>
    </div>

    <div class="bordered">
      <div class="bg-frame border-bottom padding-sm">
        <h2>Estatísticas</h2>
      </div>
      <div class="bg-body">
        <table>
          {
            circle.data.date && (
              <tr>
                <td class="muted">Fundação</td>
                <td>{formatDatePtBr(circle.data.date)}</td>
              </tr>
            )
          }
          {
            circle.data.activity && (
              <tr>
                <td class="muted">Status</td>
                <td>{toLabel(activitiesVocab, circle.data.activity)}</td>
              </tr>
            )
          }
          {
            ownedWithGames.length > 0 && (
              <tr>
                <td class="muted">Patches</td>
                <td>{ownedWithGames.length}</td>
              </tr>
            )
          }
        </table>
      </div>
    </div>

    {
      circle.data.links.length > 0 && (
        <div class="bordered">
          <div class="bg-frame border-bottom padding-sm">
            <h2>Links Externos</h2>
          </div>
          <div class="bg-body padding-md">
            <ul class="list divider-h">
              {circle.data.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label ?? link.url}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </aside>
</Base>
