---
import Base from "../../layouts/Base.astro";
import ListingForm from "../../components/search/ListingForm.astro";
import { circlesConfig } from "../../lib/search/configs";
import { getVocab, vocabLabel } from "../../lib/search/vocab";

const vocab = await getVocab();
const activitiesVocab = vocab.get("activities") ?? {};
const activityLabelMap = Object.fromEntries(
  Object.keys(activitiesVocab).map((slug) => [slug, vocabLabel(activitiesVocab, slug)])
);
---

<Base title="Círculos">
  <section class="flex flex-column gap-lg" data-circles-search>
    <div class="bordered">
      <div class="bg-frame border-bottom padding-sm">
        <h1>Círculos</h1>
      </div>
      <div class="bg-body padding-md grid grid-2col gap-md" data-circles-results>
      </div>
      <nav class="flex flex-wrap justify-center bg-frame border-top padding-sm gap-lg" aria-label="Paginação" data-circles-pagination>
      </nav>
    </div>
  </section>

  <aside class="flex flex-column gap-lg">
    <div class="bordered">
      <div class="bg-frame border-bottom padding-sm">
        <h2>Buscar Círculos</h2>
      </div>
      <ListingForm config={circlesConfig} />
    </div>
  </aside>
</Base>

<script type="module" define:vars={{ __circlesConfig: circlesConfig, __circlesVocab: { activity: activityLabelMap } }}>
  window.__circlesSearchData = { config: __circlesConfig, vocab: __circlesVocab };
</script>
<script type="module">
  import { initListing } from "../../lib/search/engine.ts";
  const { config, vocab } = window.__circlesSearchData;
  initListing(config, vocab);
</script>
<script type="module">
  import "../../lib/search/suggest.ts";
</script>
