---
import Base from "../layouts/Base.astro";
---

<Base title="404 - Página Não Encontrada">
  <section class="flex flex-column gap-lg">
    <div class="bordered">
      <div class="bg-frame border-bottom padding-sm">
        <h1>Página Não Encontrada</h1>
      </div>
      <div class="bg-body padding-md flex flex-column gap-sm">
        <p>
          <img src="/oops.jpeg" alt="" loading="lazy" />
        </p>
      </div>
    </div>
  </section>

  <aside class="flex flex-column gap-lg">
    <div class="bordered">
      <div class="bg-frame border-bottom padding-sm">
        <h2>404</h2>
      </div>
      <div class="wrapper bg-frame">
        <img src="/sleepy.jpg" alt="" loading="lazy" />
      </div>
    </div>
  </aside>
</Base>
